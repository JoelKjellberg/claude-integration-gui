# Claude API Configuration
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# ============================================
# Nordnet External API v2 Configuration
# ============================================
# Get your API key from: https://www.nordnet.se/externalapi
# You need to:
# 1. Generate an ed25519 SSH key pair
# 2. Upload the PUBLIC key to Nordnet
# 3. Save the PRIVATE key securely
# 4. Nordnet will give you an API key

# Your Nordnet API key (provided after uploading public key)
NORDNET_API_KEY=your-nordnet-api-key

# Country code: se, no, dk, or fi
NORDNET_COUNTRY=se

# Path to your ed25519 private key file
# Example: /home/user/.ssh/nordnet_ed25519
NORDNET_PRIVATE_KEY_PATH=/path/to/your/private/key

# OR provide the private key content directly (useful for deployment)
# NORDNET_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"

# ============================================
# Optional: Additional Configuration
# ============================================

# Enable Nordnet integration (set to 'false' to disable)
NORDNET_ENABLED=true

# API rate limiting (milliseconds between requests)
NORDNET_RATE_LIMIT_MS=100
